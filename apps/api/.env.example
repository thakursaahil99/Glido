# Database — PostgreSQL. Point this at a local Postgres instance (free, e.g.
# the official installer at postgresql.org, or `docker run postgres`) or a
# free hosted instance (e.g. Neon, Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glido?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=4000
# Comma-separated list if the web app runs on more than one origin/port.
WEB_ORIGIN="http://localhost:3000"

# OTP delivery — "console" logs OTP to server console (free, default for demo).
# Set to "email" to send via SMTP (fill SMTP_* below, e.g. free Gmail app password).
OTP_DELIVERY="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Glido <no-reply@glido.app>"

# Payments — Razorpay TEST mode keys (free, from https://dashboard.razorpay.com/app/keys → Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
