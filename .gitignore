node_modules/
dist/
build/
.next/
*.log
.env
.env.local
.DS_Store
coverage/
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Flutter (apps/mobile, apps/delivery, apps/restaurant-partner)
.dart_tool/
.flutter-plugin-dependencies
.pub-cache/
.pub/
*.iml
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/*.jks
**/android/app/*.keystore
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/ios/Pods/
# *.apk/*.aab/*.ipa are ignored everywhere EXCEPT apps/web/public/downloads/ — those are
# committed on purpose so the live site's download links survive every git-triggered redeploy
# (Vercel builds from a fresh checkout; a locally-built APK not in git disappears on the next push).
*.apk
*.aab
*.ipa
!apps/web/public/downloads/*.apk

.vercel
.env*
